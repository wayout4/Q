name = "quantum-q-number-api"
main = "src/index.js"
compatibility_date = "2026-10-01"

[vars]
# Exact origin only; no trailing slash or path.
ALLOWED_ORIGIN = "https://wayout4.github.io"
# Hostname returned by Turnstile verification.
ALLOWED_HOSTNAME = "wayout4.github.io"

[[d1_databases]]
binding = "DB"
database_name = "quantum-q-number"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"

# Built-in abuse protection: five registration attempts per installation per minute.
# The namespace ID should be unique within the Cloudflare account.
[[ratelimits]]
name = "Q_NUMBER_RATE_LIMITER"
namespace_id = "1411099351"

  [ratelimits.simple]
  limit = 5
  period = 60
